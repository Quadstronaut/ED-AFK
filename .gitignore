# Agent / council worktree scratch — .claude/worktrees is ~hundreds of MB of
# live git worktrees; NEVER commit it. Keep the council ledger (durable record).
.claude/*
!.claude/council-ledger.jsonl

# Regenerable CV debug-overlay captures dumped at the repo root (the detector
# re-emits these live). Raw reference frames belong in tests/fixtures/ instead.
/station_menu_*.png
/compass_zoom.png

# Agent / calibration scratch in the nested project (the rules above are
# root-anchored and miss projects/ed-autojump/, so anchor them here too).
projects/ed-autojump/.claude/
projects/ed-autojump/calibration/*.png
projects/ed-autojump/calibration/*.json
